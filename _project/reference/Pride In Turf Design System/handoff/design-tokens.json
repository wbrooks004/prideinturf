{
  "$schema": "Pride In Turf Design System — machine-readable design tokens",
  "meta": {
    "designSystemVersion": "1.1.0",
    "approvalStatus": "Reference tokens — pending explicit client approval before production use in Etch WP",
    "generatedFrom": ["tokens/colors.css", "tokens/typography.css", "tokens/spacing.css", "tokens/effects.css", "tokens/layout.css"],
    "brandSourcePinned": "Pride in Turf BrandBook-V1.pdf — logo, green #76bc43, orange #f69622, ink #231f20 pinned exactly; all tints/shades synthesized in OKLCH"
  },

  "color": {
    "brand": {
      "green500": { "value": "#76bc43", "cssVar": "--color-green-500", "note": "Pinned from brand book. Primary brand color." },
      "orange500": { "value": "#f69622", "cssVar": "--color-orange-500", "note": "Pinned from brand book. Accent color." },
      "ink900": { "value": "#231f20", "cssVar": "--color-neutral-900", "note": "Pinned from brand book. Also = --brand-ink." },
      "white": { "value": "#ffffff", "cssVar": "--color-neutral-0" }
    },
    "greenRamp": {
      "50": "oklch(97% 0.03 128)", "100": "oklch(93% 0.06 128)", "200": "oklch(87% 0.09 128)",
      "300": "oklch(80% 0.13 128)", "400": "oklch(75% 0.16 128)", "500": "#76bc43",
      "600": "oklch(60% 0.16 130)", "700": "oklch(49% 0.14 132)", "800": "oklch(39% 0.12 132)", "900": "oklch(29% 0.09 132)"
    },
    "orangeRamp": {
      "50": "oklch(97% 0.025 60)", "100": "oklch(93% 0.05 58)", "200": "oklch(87% 0.09 56)",
      "300": "oklch(81% 0.13 54)", "400": "oklch(76% 0.16 52)", "500": "#f69622",
      "600": "oklch(63% 0.17 48)", "700": "oklch(53% 0.15 44)", "800": "oklch(43% 0.13 40)", "900": "oklch(33% 0.10 38)"
    },
    "neutralRamp": {
      "0": "#ffffff", "50": "oklch(98% 0.002 45)", "100": "oklch(95% 0.004 45)", "200": "oklch(90% 0.006 45)",
      "300": "oklch(82% 0.008 45)", "400": "oklch(68% 0.010 45)", "500": "oklch(54% 0.012 45)",
      "600": "oklch(42% 0.012 45)", "700": "oklch(32% 0.012 45)", "800": "oklch(24% 0.010 45)",
      "900": "#231f20", "950": "oklch(10% 0.006 45)"
    },
    "semantic": {
      "success500": "var(--color-green-600)", "success700": "var(--color-green-800)",
      "warning500": "oklch(78% 0.15 82)", "warning700": "oklch(48% 0.13 70)",
      "error500": "oklch(56% 0.19 25)", "error700": "oklch(42% 0.17 25)",
      "info500": "oklch(58% 0.09 240)", "info700": "oklch(42% 0.08 240)"
    },
    "aliases": {
      "surfacePage": "var(--color-neutral-50)", "surfaceCard": "var(--color-neutral-0)",
      "surfaceSunken": "var(--color-neutral-100)", "surfaceInverse": "var(--color-neutral-900)",
      "surfaceBrand": "var(--color-green-500)", "surfaceAccent": "var(--color-orange-500)",
      "surfaceOverlayScrim": "oklch(15% 0.01 40 / 0.55)",
      "textPrimary": "var(--color-neutral-900)", "textSecondary": "var(--color-neutral-600)",
      "textTertiary": "var(--color-neutral-500)", "textDisabled": "var(--color-neutral-300)",
      "textOnBrand": "var(--color-neutral-0)", "textOnDark": "var(--color-neutral-0)",
      "textOnDarkSecondary": "oklch(100% 0 0 / 0.72)",
      "textLink": "var(--color-green-700)", "textLinkHover": "var(--color-green-800)",
      "borderDefault": "var(--color-neutral-200)", "borderStrong": "var(--color-neutral-300)",
      "borderOnDark": "oklch(100% 0 0 / 0.16)",
      "brandPrimary": "var(--color-green-500)", "brandPrimaryHover": "var(--color-green-600)",
      "brandPrimaryActive": "var(--color-green-700)", "brandPrimaryTint": "var(--color-green-50)",
      "brandAccent": "var(--color-orange-500)", "brandAccentHover": "var(--color-orange-600)",
      "brandAccentActive": "var(--color-orange-700)", "brandAccentTint": "var(--color-orange-50)",
      "focusRingColor": "var(--color-green-600)"
    },
    "contrastNotes": [
      "Brand green (#76bc43) at full saturation fails WCAG AA for text on white — use --text-link (green-700) or darker for any text usage, never raw green-500.",
      "Brand orange (#f69622) at full saturation also fails AA for small text on white — use --brand-accent-active (orange-700) for text, reserve orange-500 for fills/icons/large elements only.",
      "White text on --brand-primary (green-500) fill passes AA for large/bold UI text (buttons) but should not be used for long-form body copy."
    ]
  },

  "typography": {
    "fontFamily": { "display": "'Kanit', 'Arial Narrow', sans-serif", "body": "'Kanit', 'Helvetica Neue', Arial, sans-serif" },
    "fontSource": "Self-hosted via Fontsource CDN build (jsdelivr) — not vendored binary files. See handoff/README.md caveats.",
    "weights": {
      "regular": 400, "medium": 500, "semibold": 600, "bold": 700,
      "black": { "value": 900, "restriction": "Logo wordmark ONLY. Never use for headings or UI text." }
    },
    "scale": {
      "xs": "0.8125rem", "sm": "0.9375rem", "base": "1.0625rem", "lg": "1.25rem", "xl": "1.5rem",
      "2xl": "1.875rem", "3xl": "2.375rem", "4xl": "3rem", "5xl": "3.75rem", "6xl": "4.75rem",
      "_pxReference": { "xs": 13, "sm": 15, "base": 17, "lg": 20, "xl": 24, "2xl": 30, "3xl": 38, "4xl": 48, "5xl": 60, "6xl": 76 }
    },
    "fluidType": {
      "_note": "Optional additive ramp for Etch to adopt on hero/H1/H2 — not implemented as CSS custom properties (see tokens/typography.css comment). The fixed scale above is what every built screen actually uses.",
      "hero": { "formula": "clamp(2.25rem, 1.6rem + 3.2vw, 3.75rem)", "pxRange": [36, 60] },
      "h1": { "formula": "clamp(2rem, 1.55rem + 2.2vw, 3rem)", "pxRange": [32, 48] },
      "h2": { "formula": "clamp(1.5rem, 1.3rem + 1vw, 1.875rem)", "pxRange": [24, 30] }
    },
    "lineHeight": { "tight": 1.1, "snug": 1.25, "normal": 1.5, "relaxed": 1.65 },
    "letterSpacing": { "tight": "-0.02em", "normal": "0em", "wide": "0.04em", "eyebrow": "0.14em" }
  },

  "spacing": {
    "scale": { "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px", "32": "128px" },
    "section": { "paddingY": "96px", "paddingYSmall": "56px" },
    "container": { "max": "1200px", "narrow": "760px", "padding": "clamp(20px, 5vw, 64px)" }
  },

  "grid": {
    "columns": { "desktop": 12, "tablet": 8, "mobile": 4 },
    "gutter": "24px",
    "gutterMobile": "16px"
  },

  "contentWidths": {
    "narrow": "760px",
    "max": "1200px",
    "fullBleed": "100vw"
  },

  "border": {
    "width": "1px",
    "widthThick": "2px",
    "colorDefault": "var(--color-neutral-200)",
    "colorStrong": "var(--color-neutral-300)",
    "colorOnDark": "oklch(100% 0 0 / 0.16)"
  },

  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px", "full": "999px" },

  "shadow": {
    "sm": "0 1px 2px rgba(35, 31, 32, 0.06)",
    "md": "0 6px 16px rgba(35, 31, 32, 0.08)",
    "lg": "0 16px 40px rgba(35, 31, 32, 0.14)",
    "focus": "0 0 0 3px oklch(72% 0.15 130 / 0.45)"
  },

  "imageAspectRatios": {
    "hero": "21 / 9",
    "card": "4 / 3",
    "blogThumbnail": "16 / 10",
    "blogHero": "16 / 9",
    "square": "1 / 1",
    "portrait": "3 / 4"
  },

  "breakpoints": {
    "_note": "CSS custom properties cannot be referenced inside @media conditions — these are the canonical reference numbers; hard-code the literal px values in actual @media rules and in Etch's breakpoint settings.",
    "mobile": 390,
    "tablet": 834,
    "desktop": 1440,
    "navCollapse": { "value": 860, "note": "NavBar's own collapse point — independent of the page grid breakpoints above." }
  },

  "motion": {
    "duration": { "fast": "140ms", "base": "220ms", "slow": "360ms" },
    "easing": { "standard": "cubic-bezier(0.4, 0, 0.2, 1)", "out": "cubic-bezier(0, 0, 0.2, 1)" },
    "notes": [
      "No bounce/spring easing anywhere — brand voice is measured, not playful.",
      "No infinite decorative loops on static content.",
      "Hover/press color changes use --duration-fast; fades and small translates use --duration-base; scroll-triggered reveals use --duration-slow."
    ]
  },

  "zIndex": {
    "base": 0, "cardHover": 1, "stickyHeader": 40, "dropdownMenu": 50,
    "mobileNavPanel": 60, "overlayScrim": 70, "modal": 80, "toast": 90
  }
}
