# ==========================================================
# AI-context repo — NOT a deploy target.
# The site is deployed on Cloudways staging via AIO import.
# This repo exists so an AI assistant can read OUR work
# without wading through vendor code.
#
# Strategy: ignore everything, then explicitly un-ignore.
# Anything not whitelisted below stays out by default.
# ==========================================================

# Ignore everything
/*

# --- Repo config -----------------------------------------
!.gitignore
!.gitattributes
!README.md
# Novamira MCP client config. Safe to track: it holds no URL and no
# credential, only ${PIT_WP_*} env-var references. See
# _project/docs/NOVAMIRA.md.
!.mcp.json

# --- Design system (root) --------------------------------
# design.md is the source of truth; the two CSS files are its exports.
# Lowercase design.md only — a second DESIGN.md collides with it on
# Windows, which is where this repo is authored.
!design.md
!prideinturftokens.css
!prideinturfacss4x.css

# --- Our theme code --------------------------------------
!/themes/
/themes/*
!/themes/bricks-child/

# --- Our plugins (vendor stays out) ----------------------
# Whitelist first-party plugins here as they appear, e.g.:
# !/plugins/
# /plugins/*
# !/plugins/pride-in-turf-functionality/

# --- Project docs & exports ------------------------------
# design docs, Bricks JSON, ACF field groups,
# WPCodeBox snippet exports
!/_project/

# --- Never, under any circumstance -----------------------
# Licensed vendor code (Bricks core, ACF Pro, Automatic.css,
# Bricksfusion, WS Form Pro, WPCodeBox, BulkPress) and the
# media library are already excluded by /* above.
# Re-stated here so intent survives future edits:
/uploads/
/plugins/
/themes/bricks/
/upgrade/
/upgrade-temp-backup/
/ai1wm-backups/
/cache/
/novamira-sandbox/
*.log

# Credentials. The WP application password lives in shell env vars,
# never in the repo — but block the usual accidents anyway.
.env
.env.*
.mcp.local.json

# OS noise
.DS_Store
Thumbs.db
